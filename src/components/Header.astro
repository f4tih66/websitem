---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase, isActive } from '../utils/url';

interface Props {
  lang?: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: '/blog/', label: t('nav.blog') },
  { href: '/tags/', label: t('nav.tags') },
  { href: '/hakkimda/', label: t('nav.about') },
];
---

<a class="skip-link" href="#main">{t('nav.skip')}</a>
<header class="site-header">
  <div class="inner">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.title} — ${t('nav.home')}`}>
      <span class="caret" aria-hidden="true">&gt;_</span>
      <span>{SITE.title}</span>
    </a>
    <nav aria-label={t('nav.main')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={withBase(link.href)} aria-current={isActive(path, link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('/rss.xml')} class="rss" aria-label="RSS feed">
            {t('nav.rss')}
          </a>
        </li>
      </ul>
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0.75rem var(--space);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .caret {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text-strong);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 520px) {
    .inner {
      justify-content: center;
    }
    nav {
      width: 100%;
      justify-content: center;
    }
  }
</style>
