---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { readingTime, type Post } from '../utils/posts';
import { withBase } from '../utils/url';
import { useTranslations } from '../i18n/ui';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel = 'h2' } = Astro.props;
const { title, description, pubDate, tags, draft, lang } = post.data;
const t = useTranslations(lang);
const minutes = readingTime(post.body);
const Heading = headingLevel;
---

<article class="post-card">
  <p class="meta mono">
    <FormattedDate date={pubDate} lang={lang} />
    <span aria-hidden="true">·</span>
    <span>{minutes} {t('post.readingTime')}</span>
    {draft && <span class="draft">{t('post.draft')}</span>}
  </p>
  <Heading class="title">
    <a href={withBase(`/blog/${post.id}/`)}>{title}</a>
  </Heading>
  <p class="desc">{description}</p>
  <TagList tags={tags} label={t('post.tags')} />
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .post-card:first-child {
    padding-top: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .draft {
    color: var(--accent-contrast);
    background: var(--accent);
    padding: 0 0.4em;
    border-radius: 4px;
    font-weight: 700;
  }
  .title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .title a {
    color: var(--text-strong);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    margin: 0 0 0.85rem;
    color: var(--muted);
  }
</style>
