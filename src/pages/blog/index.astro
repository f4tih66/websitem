---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTags } from '../../utils/posts';
import { useTranslations } from '../../i18n/ui';
import { withBase } from '../../utils/url';

const t = useTranslations();
const posts = await getPublishedPosts();
const tags = getTags(posts);
---

<BaseLayout title={t('blog.title')} description={t('blog.description')}>
  <header class="page-header">
    <h1>{t('blog.title')}</h1>
    <p>{t('blog.description')}</p>
  </header>

  {
    tags.length > 0 && (
      <nav class="filter measure" aria-label={t('blog.filter')}>
        <ul class="tag-list">
          <li>
            <a class="tag all" href={withBase('/blog/')} aria-current="page">
              {t('blog.allTags')}
            </a>
          </li>
          {tags.map((tag) => (
            <li>
              <a class="tag" href={withBase(`/tags/${tag.slug}/`)}>
                {tag.name} <span class="count">({tag.count})</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="measure">
    {
      posts.length === 0 ? (
        <p class="muted">{t('blog.empty')}</p>
      ) : (
        posts.map((post) => <PostCard post={post} />)
      )
    }
  </div>
</BaseLayout>

<style>
  .filter {
    margin-bottom: 2.5rem;
  }
  .tag.all::before {
    content: '*';
  }
</style>
