---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTags, slugify, type Post, type TagInfo } from '../../utils/posts';
import { useTranslations } from '../../i18n/ui';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      allTags: tags,
      posts: posts.filter((post) => post.data.tags.some((name) => slugify(name) === tag.slug)),
    },
  }));
}

interface Props {
  tag: TagInfo;
  allTags: TagInfo[];
  posts: Post[];
}

const { tag, allTags, posts } = Astro.props;
const t = useTranslations();
const title = `#${tag.name}`;
const description = `“${tag.name}” ${t('tags.postsWith')} (${tag.count})`;
---

<BaseLayout title={title} description={description}>
  <header class="page-header">
    <h1><span class="hash" aria-hidden="true">#</span>{tag.name}</h1>
    <p>{description}</p>
  </header>

  <nav class="filter measure" aria-label={t('blog.filter')}>
    <ul class="tag-list">
      <li>
        <a class="tag all" href={withBase('/blog/')}>{t('blog.allTags')}</a>
      </li>
      {
        allTags.map((item) => (
          <li>
            <a
              class="tag"
              href={withBase(`/tags/${item.slug}/`)}
              aria-current={item.slug === tag.slug ? 'page' : undefined}
            >
              {item.name} <span class="count">({item.count})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="measure">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<style>
  .hash {
    color: var(--accent);
  }
  .filter {
    margin-bottom: 2.5rem;
  }
  .tag.all::before {
    content: '*';
  }
</style>
